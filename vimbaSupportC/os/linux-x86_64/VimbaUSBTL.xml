<?xml version="1.0" standalone="no" ?>
<Settings>
    <Logging>
    <!--
        Log Levels
            - Trace
            - Debug
            - Info
            - Warning
            - Error
            - Fatal
    -->
        <Level>Warning</Level>

        <!--
        Formats
            - AVT_Default       - Allied Visions logging format
            - CEF               - ArcSight Common Event Format.
            - ECS               - Elastic Common Schema, single-line
            - ECS_Pretty        - ECS, multi-line and indented
            - GELF              - Graylog Extended Log Format, single-line
            - GELF_Pretty       - GELF, multi-line and indented
            - JSON              - JavaScript Object Notation format, single-line
            - JSON_Pretty       - JSON, multi-line and indented
            - LEEF              - IBM Log Event Extended Format
            - LEEF_NoSysLog     - LEEF without optional syslog header
            - LTSV              - Labeled Tab-separated Values
            - Logfmt            - logfmt, recommended format for Splunk
            - Spdlog            - spdlog default format
            - Syslog_RFC5424    - Syslog (RFC 5424) Not used for syslog sink. Use this for writing syslog protocol to files or sockets.
            - Custom1           - custom format, as specified in CustomFormat1
            - Custom2           - custom format, as specified in CustomFormat2

            If no Format is specified a default value will be chosen
    -->
        <Sinks>
            <!-- <Sink type="Terminal" format="AVT_Default"/> -->
            <!-- <Sink type="TerminalColored" format="AVT_Default"/> -->
            <!-- <Sink type="File" file-path="VimbaUSBTL.log" format="AVT_Default" mode="Truncate"/> --> <!-- modes: Append, Truncate -->
            <!-- <Sink type="Syslog"/> -->
            <!-- <Sink type="SystemdJournal"/> -->
            <!-- <Sink type="WinEventLog"/> -->
            <!-- <Sink type="WinDebugConsole" format="AVT_Default"/> -->
            <!-- <Sink type="TCP" address="127.0.0.1" port="5530" format="JSON"/> -->
            <!-- <Sink type="UDP" address="127.0.0.1" port="5140" format="Syslog_RFC5424"/> -->
            <!-- <Sink type="Memento"/> -->
        </Sinks>
        <!-- For defining custom patterns use spdlog syntax
             See: https://github.com/gabime/spdlog/wiki/Custom-formatting
             Source flags (%@, %s, %g, %#) are not supported.
             Additionally the following pattern flags are available:
                %*  Diagnostic Context Data (recommended)
                %N  Numerical log level
                %/  Hostname
        -->
        <CustomFormat1>%T - USB-TL on %/ with severity: [%-8l] - Message: %v - Context: %*</CustomFormat1>
        <CustomFormat2>[%n] [%^%l%$] %v %*</CustomFormat2>
    </Logging>


    <!--
            Activate less pedantic function parameter checks (needed for some TL consumers)
            True:                           Tolerant function parameter checks
            False:                          Pedantic function parameter checks
            Default behavior if omitted:    Pedantic function parameter checks (GenTL compliant behavior)
    -->
    <TolerateTypeNullptr>True</TolerateTypeNullptr>


    <!--
            Emulate unsupported device access modes (needed for some TL consumers)
            True:                           Emulation on
            False:                          Emulation off
            Default behavior if omitted:    Emulation off (GenTL compliant behavior)
    -->
    <EmulateAccessModes>True</EmulateAccessModes>


    <!--
            Use manual maximum transfer count for USB transfers
            Decimal and hexadecimal numbers (prefixed with "0x") can be used
            Default behavior if omitted:    32
    -->
    <!-- <MaxTransferCount>32</MaxTransferCount> -->


    <!--
            Use manual maximum transfer size (in bytes) for USB transfers
            Decimal and hexadecimal numbers (prefixed with "0x") can be used
            Default behavior if omitted:    0x40000 (256 kB)
    -->
    <!-- <MaxTransferSize>0x40000</MaxTransferSize> -->


    <!--
            Number of frames to use for intermediate frame buffering. Values
            greater than 0 mean that no zero copy is possible anymore.
            Decimal and hexadecimal numbers (prefixed with "0x") can be used
            Default behavior if omitted:    0 (No intermediate frame buffering)
    -->
    <!-- <DriverBuffersCount>3</DriverBuffersCount> -->

    <!--
            Set the folder in which remote device XML files will be cached
            Default behavior if omitted:    No XML files will be cached
    -->
    <!-- <XMLCacheFolder>XMLCache</XMLCacheFolder> -->

</Settings>
